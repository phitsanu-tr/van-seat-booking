{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/book.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/trips.html",
      "destination": "/trips",
      "permanent": false
    },
    {
      "source": "/vercel.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dev.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/trips",
      "destination": "/trips.html"
    },
    {
      "source": "/trips/new",
      "destination": "/trips.html"
    },
    {
      "source": "/:t([a-hj-km-np-z2-9]{6,8})",
      "destination": "/book.html"
    }
  ],
  "headers": [
    {
      "source": "/(trips|trips/new)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
