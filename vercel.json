{
  "redirects": [
    {
      "source": "/a",
      "has": [
        {
          "type": "query",
          "key": "new",
          "value": "1"
        }
      ],
      "destination": "/trips/new",
      "permanent": false
    },
    {
      "source": "/a",
      "destination": "/trips",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/trips",
      "destination": "/trips.html"
    },
    {
      "source": "/trips/new",
      "destination": "/trips.html"
    },
    {
      "source": "/:t([a-hj-km-np-z2-9]{6,8})",
      "destination": "/book.html"
    }
  ],
  "headers": [
    {
      "source": "/(trips|trips/new|trips.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
