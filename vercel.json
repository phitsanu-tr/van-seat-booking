{
  "redirects": [
    {
      "source": "/(DESIGN\\.md|UPDATE\\.md|README\\.md|dev\\.js|vercel\\.json|tests/.*|scripts/.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/trips/new",
      "destination": "/trips.html"
    },
    {
      "source": "/trips/:t([a-hj-km-np-z2-9]{6,8})",
      "destination": "/trips.html"
    },
    {
      "source": "/owner",
      "destination": "/owner.html"
    },
    {
      "source": "/(home|trips|seats|notify|profile)",
      "destination": "/app.html"
    },
    {
      "source": "/plans",
      "destination": "/plans.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/:t([a-hj-km-np-z2-9]{6,8})",
      "destination": "/book.html"
    },
    {
      "source": "/:t([a-hj-km-np-z2-9]{6,8})/info",
      "destination": "/book.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://static.line-scdn.net https://*.line-scdn.net; connect-src 'self' https://*.line.me https://*.line-scdn.net https://*.line-apps.com wss://*.line.me wss://*.line-apps.com; font-src 'self' https://fonts.gstatic.com data:"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/:t([a-hj-km-np-z2-9]{6,8})/info",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:t([a-hj-km-np-z2-9]{6,8})",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(trips/new|trips/[a-hj-km-np-z2-9]{6,8}|owner|home|trips|seats|notify|profile|plans)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
